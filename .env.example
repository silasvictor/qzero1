# Copy to .env and edit. Never commit .env.
PORT=3000
NODE_ENV=production
# REQUIRED in production: a long random string (e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`)
JWT_SECRET=change-me
# Where the SQLite database and uploaded documents live. Mount a persistent volume here.
DATA_DIR=./data
# Comma-separated allowed email domains/suffixes for student signup
UNIVERSITY_DOMAINS=univ.edu,.edu,.ac.in
# Show the OTP in the API response (demo/hackathon mode). Set false once SMTP is configured.
SHOW_DEV_OTP=true
# Optional SMTP for real OTP / notification emails
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Q-Zero <no-reply@example.com>"
# Create demo users/kiosks/orders on first run
SEED_DEMO=true
MAX_UPLOAD_MB=10
